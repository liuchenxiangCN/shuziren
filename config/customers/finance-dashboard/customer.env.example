# Runtime
CUSTOMER_NAME=XX集团
# 注意: CUSTOMER_ID=finance-dashboard 已在 .env 中配置
CUSTOMER_CONFIG_DIR=/app/config/customers/finance-dashboard
ASK_METRICS_MODE=excel

# Frontend FVS
VITE_FVS_INTEGRATION_MODE=iframe
VITE_FVS_URL=/webroot/decision/view/duchamp?viewlet=%E9%9B%86%E5%9B%A2%E8%B4%A2%E5%8A%A1%E7%BB%BC%E5%90%88%E9%A9%BE%E9%A9%B6%E8%88%B1%2F%E9%9B%86%E5%9B%A2%E8%B4%A2%E5%8A%A1%E7%BB%BC%E5%90%88%E9%A9%BE%E9%A9%B6%E8%88%B1.fvs&page_number=1
VITE_FVS_TARGET_ORIGIN=

# Dora - keep Mock for demo; switch to real when needed
DORA_BASE_URL=https://your-dora-host
DORA_API_KEY=replace_me
DORA_AGENT_ID=
DORA_AGENT_NAME=企业财务综合驾驶舱语音助手
DORA_CHANNEL_TYPE=feishu

# ASR / TTS - real Aliyun services
ASR_PROVIDER=aliyun
ASR_API_KEY=replace_me
TTS_PROVIDER=aliyun
TTS_API_KEY=replace_me
TTS_STREAMING_ENABLED=true
TTS_STREAMING_FALLBACK=segment
TTS_STREAMING_AUDIO_FORMAT=pcm

# Mock switches - Dora/FVS stay mock, ASR/TTS use real
ENABLE_MOCK_DORA=true
ENABLE_MOCK_ASR=false
ENABLE_MOCK_TTS=false
ENABLE_MOCK_FVS=true
